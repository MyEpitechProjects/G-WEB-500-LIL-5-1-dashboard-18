
# Clé de la Web API Steam : https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Clé de l'API SNCF : https://numerique.sncf.com/
SNCF_API_KEY=

# Adresse publique de l'application (doit correspondre à l'URL ouverte dans le navigateur)
ORIGIN=http://localhost:8080

# Si false, active automatiquement le compte, sinon envoie un lien via email ou dans la console (dépendant d'autre valuer du .env)
ACCOUNT_NEED_VERIFICATION=false

# SMTP pour les emails de confirmation. Sans SMTP_HOST, le lien est écrit dans les logs du serveur.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Dashboard <no-reply@example.com>"

# Emplacement de la base SQLite (défaut en développement : ./data/dashboard.db)
# DATABASE_PATH=./data/dashboard.db
